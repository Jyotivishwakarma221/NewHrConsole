<?xml version="1.0" encoding="utf-8"?>
<layout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/greyBackground"
    android:gravity="center"
    android:orientation="vertical">

    <!-- Date -->
    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/robotomedium"
        android:text="1 April"
        android:textColor="@color/Blue"
        android:textSize="16sp" />

    <!-- Timeline Dot -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_gravity="center"

        android:orientation="horizontal">
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_10"
            android:layout_alignParentStart="true"
android:layout_alignStart="@+id/timelineDot"
            android:layout_centerInParent="true"
            android:background="@drawable/line" />
        <View
            android:id="@+id/timelineDot"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:layout_centerInParent="true"
            android:background="@drawable/green_dot" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_10"
            android:layout_centerInParent="true"
            android:layout_toEndOf="@+id/timelineDot"
            android:background="@drawable/line" />
    </RelativeLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/dm_sans"
        android:text="Joining"
        android:paddingStart="@dimen/_10"
        android:textColor="#FFFFFF"
        android:paddingEnd="@dimen/_40dp"
        android:textSize="18sp" />

</LinearLayout>
</layout>
