<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:padding="@dimen/_10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/dark_grey_bg"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:padding="5dp"
                    android:paddingEnd="@dimen/_20dp"
                    android:text="Score Tab"
                    android:textColor="@color/greyforText"
                    android:textSize="18dp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/editButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:src="@drawable/edit_icon"
                    android:visibility="invisible" />

            </LinearLayout>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pieChart"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="@dimen/_20dp"
                android:background="#111111" />

            <TextView
                android:id="@+id/keepItUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_20dp"
                android:alpha="70"
                android:background="@drawable/green_bg"
                android:gravity="center"
                android:padding="10dp"
                android:text="Awesome !! You got great rating Keep it Up"
                android:textColor="@color/greyforText"
                android:textSize="15dp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/grey_bg_rounded"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10"
                    android:gravity="center"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10dp"
                        android:gravity="center"
                        android:padding="@dimen/_5dp"
                        android:text="User Reviews"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10dp"
                        android:gravity="center"
                        android:padding="@dimen/_5dp"
                        android:text="Team work"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10dp"
                        android:gravity="center"
                        android:padding="@dimen/_5dp"
                        android:text="Skills"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10dp"
                        android:gravity="center"
                        android:padding="@dimen/_5dp"
                        android:text="Assistance"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10dp"
                        android:gravity="center"
                        android:padding="@dimen/_5dp"
                        android:text="Attendance"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10dp"
                        android:gravity="center"
                        android:padding="@dimen/_5dp"
                        android:text="Work Delivery"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10dp"
                        android:gravity="center"
                        android:padding="@dimen/_5dp"
                        android:text="Performance"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10dp"
                        android:gravity="center"
                        android:padding="@dimen/_5dp"
                        android:text="General Conduct"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10dp"
                        android:gravity="center"
                        android:padding="@dimen/_5dp"
                        android:text="Job Knowlegde"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10dp"
                        android:gravity="center"
                        android:padding="@dimen/_5dp"
                        android:text="Work Quality"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15" />


                </LinearLayout>


                <LinearLayout
                    android:id="@+id/incrementDecremntLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_margin="5dp"
                        app:middleText="0"
                        app:decrementText="-"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/blue_bg" />

                    <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                        android:id="@+id/team_inc_dec"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_margin="5dp"
                        app:middleText="0"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/blue_bg"/>

                    <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                        android:id="@+id/skill_inc_dec"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_margin="5dp"
                        app:middleText="0"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/blue_bg" />

                    <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                        android:id="@+id/assisantce_inc_dec"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_margin="5dp"
                        app:middleText="0"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/blue_bg" />

                    <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                        android:id="@+id/attendance_inc_dec"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_margin="5dp"
                        app:middleText="0"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/blue_bg" />

                    <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                        android:id="@+id/Workdelivery_inc_dec"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_margin="5dp"
                        app:middleText="0"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/blue_bg" />

                    <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                        android:id="@+id/performance_inc_dec"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_margin="5dp"
                        app:middleText="0"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/blue_bg" />

                    <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                        android:id="@+id/general_inc_dec"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_margin="5dp"
                        app:middleText="0"
                        android:layout_weight="1"
                        android:gravity="center"
                        app:decrementText="-"
                        android:paddingStart="15dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/blue_bg" />

                    <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_margin="5dp"
                        app:middleText="0"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/blue_bg" />

                    <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_margin="5dp"
                        app:middleText="0"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/blue_bg" />


                </LinearLayout>


            </LinearLayout>

            <TextView
                android:id="@+id/Update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10"
                android:background="@drawable/blue_bg"
                android:paddingStart="@dimen/_30dp"
                android:paddingTop="@dimen/_10"
                android:paddingEnd="@dimen/_30dp"
                android:paddingBottom="@dimen/_10"
                android:text="Update"
                android:textColor="@color/white"
                android:textSize="@dimen/_18sp" />
        </LinearLayout>

    </ScrollView>

</layout>
