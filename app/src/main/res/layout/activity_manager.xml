<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayouts"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/black"
    tools:context=".manager.activity.ManagerActivity">

    <include layout="@layout/manager_toolbar_layout" />

    <RelativeLayout
        android:id="@+id/eventLay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_10"
        android:elevation="@dimen/_10"
        android:visibility="gone"
        android:clickable="true"
        android:layout_marginTop="@dimen/_20dp"
        android:layout_marginLeft="@dimen/_10"
        android:layout_marginRight="@dimen/_10"
        android:layout_marginBottom="100dp"
        android:layout_below="@+id/manager_toolbar_layout"
        android:background="@drawable/event_bg">
        <ImageView
            android:id="@+id/cutImageView"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/crosssmall"
            android:scaleType="fitXY" />
        <!-- Top LinearLayout with text and image -->

            <!-- Text View -->
            <TextView
                android:id="@+id/subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:layout_below="@+id/cutImageView"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_10dp"
                android:layout_marginTop="@dimen/_20dp"
                android:layout_marginEnd="@dimen/_10dp"
                android:textStyle="bold"
                android:text="Leaves"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins"
                android:gravity="center">
            </TextView>

        <ImageView
            android:id="@+id/poster"
            android:layout_width="wrap_content"
            android:layout_height="320dp"
            android:layout_below="@+id/subject"
            android:layout_gravity="center"
            android:layout_marginStart="75dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="@dimen/_20dp"
            android:layout_marginBottom="@dimen/_10dp"
            android:background="@color/black"
            android:elevation="@dimen/_20dp"
            android:fontFamily="@font/dm_sans"
            android:src="@drawable/demo" />



    </RelativeLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:animateLayoutChanges="true"
        android:paddingBottom="@dimen/_10dp"
        android:layout_below="@+id/manager_toolbar_layout"
        app:tabGravity="fill"
        android:layout_marginTop="@dimen/_10dp"
        app:tabIndicator="@drawable/select_dashboard"
        app:tabMode="fixed"
        android:background="@color/black"
        app:tabBackground="@drawable/select_dashboard"
        app:tabSelectedTextColor="@color/white"
        app:tabTextColor="#666666" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_below="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="1500dp" />

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/manager_toolbar_layout" />

</RelativeLayout>
