<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@color/strokeBlack"
    android:orientation="horizontal"
    android:weightSum="4"
    android:padding="@dimen/_10dp">

    <TextView
        android:id="@+id/Time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="10 Am "
        android:layout_weight="1"
        android:textColor="@color/white"
        android:textSize="@dimen/_18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_10"
        android:layout_weight="3"
        android:weightSum="3"
        android:background="@drawable/black_button"
        android:orientation="horizontal">

    <TextView
        android:id="@+id/details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/_5dp"
        android:layout_marginStart="10dp"
        android:maxLines="3"
        android:layout_weight="2"
        android:text="Meeting With Sales Team"
        android:drawableStart="@drawable/sparkles"
        android:textColor="@color/white"
        android:textSize="@dimen/_15sp" />
    <TextView
        android:id="@+id/acceptMeet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:layout_weight="1"
        android:paddingLeft="@dimen/_5dp"
        android:paddingRight="@dimen/_5dp"
        android:paddingTop="@dimen/_10"
        android:paddingBottom="@dimen/_10"
        android:gravity="center"
        android:background="@drawable/blue_border"
        android:drawableTop="@drawable/green_tick"
        android:text="Accept"/>
    </LinearLayout>

</LinearLayout>
