        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Leave Date :     "
                    android:textColor="@color/greyforText"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/leaveDae"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_10"
                    android:maxLines="2"
                    android:padding="2dp"
                    android:text="April 1 2024 "
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="    Duration :    "
                    android:textColor="@color/greyforText"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"

                    android:layout_marginLeft="@dimen/_10"
                    android:maxLines="2"
                    android:padding="2dp"
                    android:text="1 Day(s)"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Manager Status :"
                    android:textColor="@color/greyforText"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/managerStatus"
                    android:layout_width="100dp"

                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_10"
                    android:maxLines="5"
                    android:padding="2dp"
                    android:text="    -----   "
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="      Reason :     "
                    android:textColor="@color/greyforText"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/Reason"

                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_10"
                    android:maxLines="10"
                    android:padding="2dp"
                    android:text="    -----   "
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10"
                android:gravity="center"
                android:paddingStart="@dimen/_15sp"
                android:weightSum="2">

                <TextView
                    android:id="@+id/decline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_20dp"
                    android:layout_marginRight="@dimen/_20dp"
                    android:layout_weight="1"
                    android:background="@drawable/red_border"
                    android:gravity="center"
                    android:padding="@dimen/_5dp"
                    android:text="Decline"
                    android:textColor="@color/greyforText"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/accept"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_20dp"
                    android:layout_marginRight="@dimen/_20dp"
                    android:layout_weight="1"
                    android:background="@drawable/green_borderbg"
                    android:gravity="center"
                    android:padding="@dimen/_5dp"
                    android:text="Accept"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</layout>
