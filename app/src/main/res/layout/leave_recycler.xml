<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:id="@+id/layoutfull"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:layout_margin="7dp"
        android:background="@drawable/grey_bg_rounded"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/_15"
        android:weightSum="5">

        <LinearLayout
            android:id="@+id/laylinear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5dp"
            android:orientation="vertical"
            android:padding="@dimen/_5dp">

            <TextView
                android:id="@+id/id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/dm_sans"
                android:text="Half Day Application"
                android:textColor="@color/white"
                android:textSize="@dimen/_16" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/dm_sans"
                android:text="Wed, 2 April"
                android:textColor="@color/greyforText"
                android:textSize="11dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/showImg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignRight="@+id/laylinear"
            android:gravity="center"
            android:text="Show Image"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:paddingStart="@dimen/_30dp"
            android:paddingEnd="@dimen/_30dp"
            android:paddingTop="@dimen/_5dp"
            android:paddingBottom="@dimen/_5dp"
            android:background="@drawable/blue_bg"
            android:textColor="@color/white"
            android:textSize="@dimen/_15"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/leavetypehalfDayReject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/laylinear"
            android:layout_marginStart="@dimen/_20dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/black_button"
            android:drawableStart="@drawable/red_dot"
            android:gravity="center"
            android:paddingStart="@dimen/_10"
            android:paddingTop="@dimen/_5dp"
            android:paddingEnd="@dimen/_10"
            android:paddingBottom="@dimen/_5dp"
            android:text="   Half Day "
            android:textColor="@color/white"
            android:visibility="invisible" />
        <TextView
            android:id="@+id/leavetypehalfDayApprove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/laylinear"
            android:layout_marginStart="@dimen/_20dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/black_button"
            android:drawableStart="@drawable/green_dot"
            android:gravity="center"
            android:paddingStart="@dimen/_10"
            android:paddingTop="@dimen/_5dp"
            android:paddingEnd="@dimen/_10"
            android:paddingBottom="@dimen/_5dp"
            android:text="   Half Day "
            android:textColor="@color/white"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/leavetypeReject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/laylinear"
            android:layout_marginStart="@dimen/_20dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/black_button"
            android:drawableStart="@drawable/red_dot"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:paddingStart="@dimen/_10"
            android:paddingTop="@dimen/_5dp"
            android:paddingEnd="@dimen/_10"
            android:paddingBottom="@dimen/_5dp"
            android:text=" Absent"
            android:textColor="@color/white" />

          <TextView
            android:id="@+id/approovedType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/laylinear"
            android:layout_marginStart="@dimen/_20dp"
            android:layout_marginTop="25dp"
              android:visibility="gone"
            android:background="@drawable/black_button"
            android:drawableStart="@drawable/green_dot"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:paddingStart="@dimen/_10"
            android:paddingTop="@dimen/_5dp"
            android:paddingEnd="@dimen/_10"
            android:paddingBottom="@dimen/_5dp"
            android:text="  Absent"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/laylinear"
            android:layout_alignParentEnd="true"
            android:layout_margin="@dimen/_5dp"
            android:layout_marginEnd="@dimen/_30dp"
            android:background="@drawable/grey_bg_rounded"
            android:gravity="center"
            android:maxLines="2"
            android:text="Awaiting"
            android:textColor="@color/white"
            android:visibility="invisible" />
<!--<TextView-->
<!--            android:id="@+id/rejected"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_below="@+id/laylinear"-->
<!--            android:layout_alignParentEnd="true"-->
<!--            android:layout_margin="@dimen/_5dp"-->
<!--            android:layout_marginEnd="@dimen/_30dp"-->
<!--            android:background="@drawable/grey_bg_rounded"-->
<!--            android:gravity="center"-->
<!--            android:maxLines="2"-->
<!--            android:text="Rejected"-->
<!--            android:textColor="@color/white"-->
<!--            android:visibility="invisible" />-->

        <LinearLayout
            android:id="@+id/approved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/laylinear"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/_50dp"
            android:background="@drawable/light_grey_bg"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/approvedOrdecline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5dp"
                android:layout_marginEnd="@dimen/_30dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="Approved by "
                android:textColor="@color/greyforText" />

            <TextView
                android:id="@+id/approvedBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5dp"
                android:layout_marginEnd="@dimen/_30dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="Megha"
                android:textColor="@color/white" />


        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/laylinear"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/_30dp"
            android:background="@drawable/dark_grey_bg"
            android:gravity="center"
            android:layout_marginTop="@dimen/_25dp"
            android:maxLines="2"
            android:padding="@dimen/_5dp"
            android:text="Awaiting "
            android:textColor="@color/greyforText"
            android:visibility="invisible" />

    </RelativeLayout>

</layout>
