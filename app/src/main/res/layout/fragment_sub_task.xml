<?xml version="1.0" encoding="utf-8"?>
<layout>
    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="@dimen/_10dp"
            tools:context=".manager.activity.fragment.NewTaskFragment">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="@dimen/_20dp">

                <ImageView

                    android:id="@+id/backBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:src="@drawable/backbutton"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Add Sub Task"
                    android:textColor="@color/greyforText"
                    android:textSize="22sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/selectText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15"
                android:padding="@dimen/_10"
                android:text="Select Employee"
                android:textColor="@color/white"
                android:textSize="@dimen/_18sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5dp">

                <AutoCompleteTextView
                    android:id="@+id/selectEmployee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/grey_bg_rounded"
                    android:drawableEnd="@drawable/baseline_arrow_drop_down_24"
                    android:padding="@dimen/_10"
                    android:hint="Select From Below"
                    android:textColorHint="@color/greyforText"
                    android:textColor="@color/greyforText"
                    android:textSize="@dimen/_18sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="Task Name"
                android:textColor="@color/greyforText"
                android:textSize="20sp" />
            <EditText
                android:id="@+id/taskname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/grey_bg_rounded"
                android:gravity="center"
                android:inputType="textMultiLine"
                android:isScrollContainer="true"
                android:lines="2"
                android:padding="10dp"
                android:textColor="@color/white" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="Task Description"
                android:textColor="@color/greyforText"
                android:textSize="20sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:fillViewport="true">

                <EditText
                    android:id="@+id/taskDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="@drawable/grey_bg_rounded"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:isScrollContainer="true"
                    android:lines="10"
                    android:padding="10dp"
                    android:textColor="@color/white" />
            </ScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Deadline"
                android:textColor="@color/white"
                android:textSize="18dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10">

                <ImageView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp"
                    android:background="@drawable/blue_bg"
                    android:padding="@dimen/_10"
                    android:src="@drawable/clock_white" />

                <TextView
                    android:id="@+id/selectedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_marginStart="@dimen/_10dp"
                    android:background="@drawable/grey_bg_rounded"
                    android:gravity="center"
                    android:maxLines="5"
                    android:padding="@dimen/_10"
                    android:text="  Select Time  "
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/calender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp"
                    android:background="@drawable/blue_bg"
                    android:padding="@dimen/_10"
                    android:src="@drawable/baseline_calendar_month_24" />

                <TextView
                    android:id="@+id/deadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_marginStart="@dimen/_10dp"
                    android:background="@drawable/grey_bg_rounded"
                    android:gravity="center"
                    android:maxLines="5"
                    android:padding="@dimen/_10"
                    android:text="  Select Date  "
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upload File"
                    android:textColor="@color/white"
                    android:textSize="18dp" />

                <ImageView
                    android:id="@+id/uploadDoc"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="end"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_weight="1"
                    android:background="@drawable/grey_bg_rounded"
                    android:padding="@dimen/_5dp"
                    android:src="@drawable/uploadwhite" />

                <TextView
                    android:id="@+id/uploadDocname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/baseline_close_24"
                    android:gravity="center"
                    android:paddingTop="@dimen/_20dp"
                    android:src="@drawable/uploadwhite"
                    android:text="File "
                    android:textColor="@color/white"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_100dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:id="@+id/delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_weight="1"
                    android:background="@drawable/delete_btn"
                    android:gravity="center"
                    android:paddingTop="@dimen/_10"
                    android:paddingBottom="@dimen/_10"
                    android:text="x  Delete"
                    android:textColor="@color/white"
                    android:textSize="18dp" />

                <TextView
                    android:id="@+id/assignTask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/attendancebutton"
                    android:gravity="center"
                    android:paddingTop="@dimen/_10"
                    android:paddingBottom="@dimen/_10"
                    android:text="+   Add Task"
                    android:textColor="@color/white"
                    android:textSize="18dp" />


            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</layout>
