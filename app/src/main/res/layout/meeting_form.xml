<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/cardview_border"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_10"
        android:paddingTop="@dimen/_20dp"
        android:paddingBottom="@dimen/_20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:padding="@dimen/_10"
            android:text="Add a Meeting"
            android:textColor="@color/white"
            android:textSize="@dimen/_20dp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Broker"
                android:textColor="@color/white" />
        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5dp"
            android:fontFamily="@font/dm_sans"
            android:padding="@dimen/_10"
            android:text="Channel Partner Name"
            android:textColor="@color/white"
            android:textSize="@dimen/_15" />

        <EditText
            android:id="@+id/channelPartnerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/grey_bg_rounded"
            android:fontFamily="@font/dm_sans"
            android:hint="Channel Partner Name"
            android:padding="@dimen/_10"
            android:textColor="@color/greyforText"
            android:textColorHint="@color/greyforText"
            android:textSize="@dimen/_15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5dp"
            android:fontFamily="@font/dm_sans"
            android:padding="@dimen/_10"
            android:text="Source"
            android:textColor="@color/white"
            android:textSize="@dimen/_15" />

        <EditText
            android:id="@+id/Source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/grey_bg_rounded"
            android:fontFamily="@font/dm_sans"
            android:hint="Source"
            android:padding="@dimen/_10"
            android:textColor="@color/greyforText"
            android:textColorHint="@color/greyforText"
            android:textSize="@dimen/_15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5dp"
            android:fontFamily="@font/dm_sans"
            android:padding="@dimen/_10"
            android:text="Client Name * "
            android:textColor="@color/white"
            android:textSize="@dimen/_15" />

        <EditText
            android:id="@+id/ClientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/grey_bg_rounded"
            android:fontFamily="@font/dm_sans"
            android:hint="Client Name"
            android:padding="@dimen/_10"
            android:textColor="@color/greyforText"
            android:textColorHint="@color/greyforText"
            android:textSize="@dimen/_15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5dp"
            android:fontFamily="@font/dm_sans"
            android:padding="@dimen/_10"
            android:text="Client Email"
            android:textColor="@color/white"
            android:textSize="@dimen/_15" />

        <EditText
            android:id="@+id/ClientEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/grey_bg_rounded"
            android:fontFamily="@font/dm_sans"
            android:hint="gmail.com"
            android:padding="@dimen/_10"
            android:textColor="@color/greyforText"
            android:textColorHint="@color/greyforText"
            android:textSize="@dimen/_15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5dp"
            android:fontFamily="@font/dm_sans"
            android:padding="@dimen/_10"
            android:text="Client Phone *"
            android:textColor="@color/white"
            android:textSize="@dimen/_15" />

        <EditText
            android:id="@+id/ClientPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/grey_bg_rounded"
            android:fontFamily="@font/dm_sans"
            android:hint="+91--------"
            android:padding="@dimen/_10"
            android:textColor="@color/greyforText"
            android:textColorHint="@color/greyforText"
            android:textSize="@dimen/_15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5dp"
            android:fontFamily="@font/dm_sans"
            android:padding="@dimen/_10"
            android:text="Client Address"
            android:textColor="@color/white"
            android:textSize="@dimen/_15" />

        <EditText
            android:id="@+id/ClientAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/grey_bg_rounded"
            android:fontFamily="@font/dm_sans"
            android:hint="Client Address"
            android:padding="@dimen/_10"
            android:textColor="@color/greyforText"
            android:textColorHint="@color/greyforText"
            android:textSize="@dimen/_15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5dp"
            android:fontFamily="@font/dm_sans"
            android:padding="@dimen/_10"
            android:text="Feedback *"
            android:textColor="@color/white"
            android:textSize="@dimen/_15" />

        <EditText
            android:id="@+id/Feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/grey_bg_rounded"
            android:fontFamily="@font/dm_sans"
            android:hint="Feedback here"
            android:padding="@dimen/_10"
            android:textColor="@color/greyforText"
            android:textColorHint="@color/greyforText"
            android:textSize="@dimen/_15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5dp"
            android:fontFamily="@font/dm_sans"
            android:padding="@dimen/_10"
            android:text="Project Details"
            android:textColor="@color/white"
            android:textSize="@dimen/_15" />

        <EditText
            android:id="@+id/ProjectDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/grey_bg_rounded"
            android:fontFamily="@font/dm_sans"
            android:hint="Project Details"
            android:padding="@dimen/_10"
            android:textColor="@color/greyforText"
            android:textColorHint="@color/greyforText"
            android:textSize="@dimen/_15" />

        <TextView
            android:id="@+id/ok_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15"
            android:background="@drawable/blue_border"
            android:gravity="center"
            android:paddingVertical="@dimen/_15"
            android:text="Add Meeting"
            android:textColor="@color/white"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15"
            android:background="@drawable/red_border"
            android:gravity="center"
            android:paddingVertical="@dimen/_15"
            android:text="Cancel"
            android:textColor="@color/white"
            android:textSize="20dp" />
    </LinearLayout>
</ScrollView>
