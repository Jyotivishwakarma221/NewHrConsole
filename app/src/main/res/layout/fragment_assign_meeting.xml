<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".admin.fragment.AssignTaskFragment">

    <FrameLayout
        android:id="@+id/move"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15"
                android:layout_marginEnd="@dimen/_15"
                android:elevation="@dimen/_20dp"
                android:layout_gravity= "center"
                android:gravity = "center"
                android:layout_marginTop="@dimen/_30dp"
                app:cardBackgroundColor="@color/Card"
                app:cardCornerRadius="@dimen/_10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Purpose"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/white"
                        android:layout_marginStart="@dimen/_10dp"/>

                    <EditText
                        android:id="@+id/purpose"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/leave_request"
                        android:paddingStart="@dimen/_10"
                        android:paddingEnd="@dimen/_10"
                        android:hint="Enter Purpose"
                        android:textColorHint="@color/white"
                        android:layout_marginStart="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_10dp"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:inputType="text"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/white"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="@dimen/_10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/spinner_back"
                        android:orientation="horizontal"
                        android:layout_marginStart="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_10dp">

                        <TextView
                            android:id="@+id/date"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:fontFamily="@font/poppins"
                            android:layout_marginStart="@dimen/_10dp"
                            android:text="@string/dd_mm_yyyy"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_13sp" />

                        <ImageView
                            android:id="@+id/calenderImgs"
                            android:layout_width="@dimen/_40dp"
                            android:layout_height="@dimen/_20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/visit" />
                    </LinearLayout>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Time"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/white"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="@dimen/_10dp"/>

                    <TextView
                        android:id="@+id/click_Time"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/leave_request"
                        android:gravity="center"
                        android:textSize="@dimen/_13sp"
                        android:textColor="@color/white"
                        android:layout_marginStart="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_10dp"
                        android:hint="Click to select time"
                        android:textColorHint="@color/white"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/white"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_10dp"/>

                    <EditText
                        android:id="@+id/meetingEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_100dp"
                        android:layout_marginTop="@dimen/_5dp"
                        android:background="@drawable/leave_request"
                        android:paddingStart="@dimen/_10"
                        android:paddingEnd="@dimen/_10"
                        android:paddingTop="@dimen/_5dp"
                        android:hint="Enter Description"
                        android:textSize="14sp"
                        android:gravity="start|top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:scrollHorizontally="false"
                        android:textColorHint="@color/white"
                        android:textColor="@color/white"
                        android:layout_marginStart="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_10dp"/>

                    <EditText
                        android:id="@+id/location"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/leave_request"
                        android:paddingStart="@dimen/_10"
                        android:paddingEnd="@dimen/_10"
                        android:textSize="14sp"
                        android:hint="Enter Location"
                        android:textColorHint="@color/white"
                        android:textColor="@color/white"
                        android:layout_marginStart="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40dp"
                        android:layout_marginTop="@dimen/_20dp"
                        android:orientation="horizontal"
                        android:layout_marginStart="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_10dp">

                        <Spinner
                            android:id="@+id/spinner_Employee"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_10dp"
                            android:layout_marginEnd="@dimen/_10dp"
                            android:hint="@string/leave_types"
                            android:backgroundTint="@color/white"/>

                    </LinearLayout>

                    <Button
                        android:id="@+id/submitButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/submit"
                        android:textSize="@dimen/_13sp"
                        style="@style/CustomButtonStyle"
                        android:textColor="@color/white"
                        android:layout_marginTop="@dimen/_10dp"
                        android:background="@drawable/button_back"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </ScrollView>
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
