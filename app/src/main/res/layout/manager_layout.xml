<?xml version="1.0" encoding="utf-8"?>
<layout>

<RelativeLayout
    android:id="@+id/full_Layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black">

    <!-- Included manager toolbar layout -->
<!--    <include layout="@layout/manager_toolbar_layout" />-->

    <RelativeLayout
        android:id="@+id/importantMeeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        >

        <TextView
            android:id="@+id/textViewImportantMeetings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:fontFamily="@font/dm_sans"
            android:text="Important Meetings"
            android:visibility="gone"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textViewSeeAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="See All >"
            android:visibility="gone"
            android:fontFamily="@font/dm_sans"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:layout_alignParentEnd="true"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textViewSeeAll"
            android:padding="5dp"
            android:layout_marginTop="@dimen/_10"
            android:id="@+id/meetingRecycle"/>

        <!-- Adding a ScrollView below the "console" TextView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/console"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/checkNowButton"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="#6D9BFF"
                    app:cardCornerRadius="18dp">

                    <!-- Adding TextView for "My Performance" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Performance Insights"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:fontFamily="@font/dm_sans"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginTop="20dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/_30dp"
            android:layout_gravity="center">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="140dp"
                        android:src="@drawable/tabletscreen">
                    </ImageView>

                    <ImageView
                        android:id="@+id/performanceBtn"
                        android:layout_width="100dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_20dp"
                        android:layout_alignParentRight="true"
                        android:fontFamily="@font/dm_sans"
                        android:src="@drawable/mdtp_ic_chevron_right_black_24dp"
                        android:textColorHint="@color/white"
                        android:textSize="14sp" />

        </LinearLayout>

                </androidx.cardview.widget.CardView>



                <androidx.cardview.widget.CardView
                    android:id="@+id/CreateAssignmnet"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="#252525"
                    app:cardCornerRadius="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Assignements"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:fontFamily="@font/dm_sans"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginTop="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/_30dp"
                        android:layout_gravity="center">

                        <!-- ImageView -->
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/task_icon"
                            android:layout_weight="1"
                            android:layout_marginEnd="140dp"
                            />

                        <!-- Button -->
                        <ImageView
                            android:id="@+id/AssignMntBtn"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:hint="Create Now"
                            android:elevation="@dimen/_20dp"
                            android:textSize="14sp"
                            android:layout_weight="1"
                            android:fontFamily="@font/dm_sans"
                            android:layout_marginEnd="@dimen/_20dp"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp"
                            />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/CheckMeeting"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="#5C7378"
                    app:cardCornerRadius="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meetings"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:fontFamily="@font/dm_sans"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginTop="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/_30dp"
                        android:layout_gravity="center">

                        <!-- ImageView -->
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/message"
                            android:layout_weight="1"
                            android:layout_marginEnd="120dp"
                            />

                        <!-- Button -->
                        <ImageView
                            android:id="@+id/Meetings"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:hint="Check Now"
                            android:elevation="@dimen/_20dp"
                            android:textSize="14sp"
                            android:layout_weight="1"
                            android:fontFamily="@font/dm_sans"
                            android:layout_marginEnd="@dimen/_20dp"
                            style="@style/BlackButton"
                            android:textColorHint="@color/white"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/leavesCheckNowBtn"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="#CE3262"
                    app:cardCornerRadius="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Leaves "
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:fontFamily="@font/dm_sans"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginTop="20dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/_30dp"
                        android:layout_gravity="center">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="140dp"
                        android:src="@drawable/leave_icon">
                    </ImageView>

                        <ImageView
                            android:id="@+id/MyLeaveBtn"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:hint="Create Now"
                            android:elevation="@dimen/_20dp"
                            android:textSize="14sp"
                            android:layout_weight="1"
                            android:fontFamily="@font/dm_sans"
                            android:layout_marginEnd="@dimen/_20dp"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/createTaskButton"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="#252525"
                    app:cardCornerRadius="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Task"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:fontFamily="@font/dm_sans"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginTop="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/_30dp"
                        android:layout_gravity="center">

                        <!-- ImageView -->
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/project_icon"
                            android:layout_weight="1"
                            android:layout_marginEnd="140dp"
                            />

                        <!-- Button -->
                        <ImageView
                            android:id="@+id/TaskBtn"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:hint="Create Now"
                            android:elevation="@dimen/_20dp"
                            android:textSize="14sp"
                            android:layout_weight="1"
                            android:fontFamily="@font/dm_sans"
                            android:layout_marginEnd="@dimen/_20dp"
                            style="@style/BlackButton"
                            android:textColorHint="@color/white"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/CheckNowMessage"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="#5C7378"
                    app:cardCornerRadius="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Messages"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:fontFamily="@font/dm_sans"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginTop="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/_30dp"
                        android:layout_gravity="center">

                        <!-- ImageView -->
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/message"
                            android:layout_weight="1"
                            android:layout_marginEnd="120dp"
                            />

                        <!-- Button -->
                        <ImageView
                            android:id="@+id/MessgeBtn"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:hint="Check Now"
                            android:elevation="@dimen/_20dp"
                            android:textSize="14sp"
                            android:layout_weight="1"
                            android:fontFamily="@font/dm_sans"
                            android:layout_marginEnd="@dimen/_20dp"
                            style="@style/BlackButton"
                            android:textColorHint="@color/white"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/checkPayoutsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/black"
                    app:cardCornerRadius="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Benefits &amp; Pay"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:fontFamily="@font/dm_sans"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginTop="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="40dp"
                        android:layout_gravity="center">

                        <!-- ImageView -->
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/benefit_icon"
                            android:layout_weight="1" />

                        <!-- Button -->
                        <ImageView
                            android:id="@+id/payBtn"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:hint="Check Payouts"
                            android:elevation="@dimen/_20dp"
                            android:textSize="14sp"
                            android:layout_weight="1"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp"
                            android:layout_marginStart="90dp"
                            android:fontFamily="@font/dm_sans"
                            android:layout_marginEnd="@dimen/_20dp"
                            style="@style/CustomButton"
                            android:textColorHint="@color/white"
                           />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/feedbackBtn"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="#6D9BFF"
                    app:cardCornerRadius="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Feedback &amp; Query"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:fontFamily="@font/dm_sans"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/_20sp"
                        android:layout_marginTop="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="40dp"
                        android:layout_gravity="center">

                        <!-- ImageView -->
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/feedback_icon"
                            android:layout_weight="1" />

                        <!-- Button -->
                        <ImageView
                            android:id="@+id/FeedBackBtn"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:hint="Check Payouts"
                            android:elevation="@dimen/_20dp"
                            android:textSize="14sp"
                            android:layout_weight="1"
                            android:layout_marginStart="90dp"
                            android:fontFamily="@font/dm_sans"
                            android:layout_marginEnd="@dimen/_20dp"
                            style="@style/CustomButton"
                            android:textColorHint="@color/white"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp"
                            />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </ScrollView>

        <!-- Adding the console TextView -->
        <TextView
            android:id="@+id/console"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Console"
            android:fontFamily="@font/space_grotesk_bold"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:visibility="gone"
            android:layout_below="@id/meetingRecycle"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/fabAttendance"
            android:layout_width="@dimen/_150dp"
            android:layout_height="50dp"
            android:hint="@string/add_attendance"
            android:fontFamily="@font/dm_sans"
            style="@style/AttendanceButton"
            android:textColorHint="@color/white"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/attendancebutton"
            android:layout_marginBottom="16dp" />


    </RelativeLayout>

</RelativeLayout>
</layout>
