<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/custom_border"
    android:orientation="vertical"
    android:layout_marginVertical="@dimen/_10dp"
    android:id="@+id/userAttendanceLinearLayout"
    android:paddingHorizontal="@dimen/_10dp"
    android:paddingVertical="@dimen/_10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/locationLinearLayout"
        android:visibility="gone">

        <com.google.android.gms.maps.MapView
            android:id="@+id/inLocationMap"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:background="@drawable/custom_border"
            android:layout_marginRight="2dp"
            android:layout_height="250dp" />

        <com.google.android.gms.maps.MapView
            android:id="@+id/outLocationMap"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:background="@drawable/custom_border"
            android:layout_marginLeft="2dp"
            android:layout_height="250dp" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_gravity="center">

        <TextView
            android:id="@+id/attendanceTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Attendance Date"
            android:fontFamily="@font/poppins"
            android:textColor="@color/white" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/_30dp">

        <TextView
            android:id="@+id/inTimeAttendance"
            android:layout_width="100dp"
            android:layout_height="@dimen/_30dp"
            android:layout_alignParentStart="true"
            android:background="@drawable/rounded_background"
            android:gravity="center"
            android:text="IN TIME"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="@font/poppins"
            />

        <TextView
            android:id="@+id/outTimeAttendance"
            android:layout_width="100dp"
            android:layout_height="@dimen/_30dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/rounded_background"
            android:gravity="center"
            android:text="OUT TIME"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="@font/poppins"/>

    </RelativeLayout>

</LinearLayout>