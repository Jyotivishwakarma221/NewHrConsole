<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="600dp"
    android:background="@drawable/grey_bg_rounded"
    android:orientation="vertical"
    android:paddingStart="@dimen/_20dp"
    android:paddingTop="@dimen/_20dp"
    android:paddingEnd="@dimen/_20dp"
    android:paddingBottom="@dimen/_40dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20dp"
        android:padding="@dimen/_10"
        android:text="Filters"
        android:textColor="#C4C4C4"
        android:textSize="@dimen/_18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5dp"
            android:text="Start Date"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/startDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/medium_grey_bg"
            android:drawableEnd="@drawable/baseline_calendar_month_24"
            android:padding="@dimen/_10"
            android:text="Start Date"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20dp"
            android:padding="@dimen/_5dp"
            android:text="End Date"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/endDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/medium_grey_bg"
            android:drawableEnd="@drawable/baseline_calendar_month_24"
            android:padding="@dimen/_10"
            android:text="End Date"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20dp"
            android:padding="@dimen/_5dp"
            android:text="Status"
            android:textColor="@color/white" />

        <Spinner
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5dp"
            android:background="@drawable/medium_grey_bg"
            android:padding="@dimen/_5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20dp"
            android:padding="@dimen/_5dp"
            android:text="Personal"
            android:textColor="@color/white" />

        <Spinner
            android:id="@+id/personal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="@dimen/_5dp"
            android:background="@drawable/medium_grey_bg"
            android:padding="@dimen/_5dp" />


        <TextView
            android:id="@+id/showresult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_10"
            android:background="@drawable/blue_border"
            android:gravity="center"
            android:paddingStart="@dimen/_25dp"
            android:paddingTop="@dimen/_10dp"
            android:paddingEnd="@dimen/_25dp"
            android:paddingBottom="@dimen/_10dp"
            android:text="Show Results"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>