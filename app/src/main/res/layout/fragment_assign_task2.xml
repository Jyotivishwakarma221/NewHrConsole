<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:orientation="vertical"
        android:clickable="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/black"
            android:focusable="true"
            android:orientation="vertical"
        android:clickable="true"
        android:padding="@dimen/_10dp"
        tools:context=".manager.activity.fragment.MyPerformance">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Assign Task "
                android:layout_marginTop="20dp"
                android:textColor="@color/greyforText"
                android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15"
                android:padding="@dimen/_10"
                android:text="Select Employee"
                android:textColor="@color/white"
                android:textSize="@dimen/_18sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5dp">

                <AutoCompleteTextView
                    android:id="@+id/selectEmployee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/grey_bg_rounded"
                    android:drawableEnd="@drawable/baseline_arrow_drop_down_24"
                    android:padding="@dimen/_10"
                    android:hint="Select From Below"
                    android:textColorHint="@color/greyforText"
                    android:textColor="@color/greyforText"
                    android:textSize="@dimen/_18sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="Task Title"
                android:textColor="@color/greyforText"
                android:textSize="22sp" />
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:fillViewport="true">

                <EditText
                    android:id="@+id/tasktitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="@drawable/grey_bg_rounded"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:isScrollContainer="true"
                    android:lines="3"
                    android:padding="10dp"
                    android:textColor="@color/white" />
            </ScrollView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15"
                android:padding="@dimen/_10"
                android:text="Task Description"
                android:textColor="@color/white"
                android:textSize="@dimen/_18sp" />


            <EditText
                android:id="@+id/taskDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/grey_bg_rounded"
                android:hint="Prepare a PPT "
                android:lines="5"
                android:maxLines="5"
                android:padding="@dimen/_5dp"
                android:textColor="@color/greyforText"
                android:textColorHint="@color/greyforText"
                android:textSize="16dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deadline"
                android:layout_gravity="start"
                android:layout_margin="5dp"
                android:textColor="@color/white"
                android:textSize="18dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10">

                <ImageView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp"
                    android:background="@drawable/blue_bg"
                    android:padding="@dimen/_10"
                    android:src="@drawable/clock_white" />

                <TextView
                    android:id="@+id/selectedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_marginStart="@dimen/_10dp"
                    android:background="@drawable/grey_bg_rounded"
                    android:gravity="center"
                    android:maxLines="5"
                    android:padding="@dimen/_10"
                    android:text="  Select Time  "
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/calender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp"
                    android:background="@drawable/blue_bg"
                    android:padding="@dimen/_10"
                    android:src="@drawable/baseline_calendar_month_24" />

                <TextView
                    android:id="@+id/deadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_marginStart="@dimen/_10dp"
                    android:background="@drawable/grey_bg_rounded"
                    android:gravity="center"
                    android:maxLines="5"
                    android:padding="@dimen/_10"
                    android:text="  Select Date  "
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5dp"
                android:layout_marginTop="@dimen/_10"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upload File"
                    android:textColor="@color/white"
                    android:textSize="18dp" />

                <ImageView
                    android:id="@+id/uploadDoc"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="end"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_weight="1"
                    android:background="@drawable/grey_bg_rounded"
                    android:padding="@dimen/_5dp"
                    android:src="@drawable/uploadwhite" />

<!--                <TextView-->
<!--                    android:id="@+id/uploadDocname"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_gravity="end"-->
<!--                    android:layout_margin="@dimen/_5dp"-->
<!--                    android:layout_weight="1"-->
<!--                    android:drawableEnd="@drawable/baseline_close_24"-->
<!--                    android:gravity="center"-->
<!--                    android:padding="@dimen/_5dp"-->
<!--                    android:src="@drawable/uploadwhite"-->
<!--                    android:text="naskdn"-->
<!--                    android:textColor="@color/white"-->
<!--                    android:visibility="gone" />-->
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fileRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_below="@+id/scroll"
                android:foregroundGravity="center"
                android:padding="5dp" />


            <Button
                android:id="@+id/assignTask"
                style="@style/AttendanceButton"
                android:layout_width="@dimen/_150dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_margin="30dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/attendancebutton"
                android:fontFamily="@font/dm_sans"
                android:hint="Assign Task "
                android:textColorHint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</layout>

