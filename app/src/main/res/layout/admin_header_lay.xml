<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="230dp"
    android:background="@color/Background">

    <!-- Profile Image -->
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/image_Profile"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:scaleType="centerCrop"
        app:riv_oval="true"/>
    <!-- Green Dot Overlay -->

    <View
        android:id="@+id/green_Dots"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignTop="@id/image_Profile"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="-17dp"
        android:layout_toStartOf="@id/image_Profile"
        android:background="@drawable/green_dot"
        android:visibility="visible" />

    <TextView
        android:id="@+id/name_Texts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/image_Profile"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins"
        android:textColor="@color/white"
        android:gravity="center"
        android:textSize="15sp"/>

    <!-- Designation TextView -->
    <TextView
        android:id="@+id/designation_Texts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/name_Texts"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:textSize="15sp"/>

    <!-- Linear Layout for Two Text Views -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_10dp"
        android:layout_marginStart="@dimen/_40dp"
        android:layout_below="@+id/designation_Texts">

        <!-- First TextView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/last_login"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins"
            android:textSize="14sp"
            android:layout_marginStart="@dimen/_5dp"/>

        <!-- Second TextView -->
        <TextView
            android:id="@+id/last_Login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/_5dp"
            android:layout_marginEnd="@dimen/_5dp"
            android:textColor="@color/white"
            android:textSize="14sp"/>

    </LinearLayout>
</RelativeLayout>
