<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:orientation="vertical"
            android:padding="@dimen/_10dp"
            tools:context=".manager.activity.AchievementFragment">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10"
                android:background="@drawable/dark_grey_bg"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/half_round_bg"
                    android:padding="5dp"
                    android:text="Last Review Insights"
                    android:textColor="@color/greyforText"
                    android:textSize="18dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_10"
                    android:layout_marginStart="@dimen/_5dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/grey_bg_rounded"
                    android:orientation="horizontal"
                    android:padding="@dimen/_5dp">


                    <ImageView
                        android:id="@+id/profilephoto"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/_5dp"
                        android:src="@drawable/profilephoto" />

                    <TextView
                        android:id="@+id/messgFrom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/grey_bg_rounded"
                        android:paddingStart="@dimen/_20dp"
                        android:paddingTop="@dimen/_5dp"
                        android:paddingBottom="@dimen/_5dp"
                        android:text="      "
                        android:textColor="#CCCCCC" />

                    <TextView
                        android:id="@+id/dateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/grey_bg_rounded"
                        android:maxLines="1"
                        android:paddingStart="@dimen/_10dp"
                        android:paddingTop="@dimen/_5dp"
                        android:paddingEnd="@dimen/_20dp"
                        android:paddingBottom="@dimen/_5dp"
                        android:text="        "
                        android:textColor="#666666"
                        android:textSize="14dp" />
                </LinearLayout>


                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/Heading"
                    android:layout_margin="@dimen/_10"
                    android:layout_marginStart="@dimen/_20dp"
                    android:layout_marginEnd="@dimen/_20dp"
                    android:layout_marginBottom="@dimen/_20dp"
                    android:background="@drawable/medium_grey_bg"
                    android:gravity="start"
                    android:maxLength="400"
                    android:maxLines="5"
                    android:padding="@dimen/_15"
                    android:text="                 "
                    android:textColor="#CCCCCC" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_10"
                android:background="@drawable/dark_grey_bg"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:padding="5dp"
                        android:paddingEnd="@dimen/_20dp"
                        android:text="Score Tab"
                        android:textColor="@color/greyforText"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/editButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:src="@drawable/edit_icon"
                        android:visibility="invisible" />

                </LinearLayout>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChart"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="50dp"
                    android:layout_marginBottom="@dimen/_20dp"
                    android:background="#111111" />

                <TextView
                    android:id="@+id/keepItUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_20dp"
                    android:alpha="70"
                    android:background="@drawable/green_bg"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="Awesome !! You got great rating Keep it Up"
                    android:textColor="@color/greyforText"
                    android:textSize="15dp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/progressLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/grey_bg_rounded"
                    android:visibility="visible"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10"
                        android:gravity="center"
                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="User Reviews"
                            android:visibility="gone"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Team work"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Skills"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5dp"
                            android:gravity="center"
                            android:visibility="gone"
                            android:padding="@dimen/_5dp"
                            android:text="Assistance"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Attendance"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Work Delivery"
                            android:visibility="gone"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Performance"
                            android:visibility="gone"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="General Conduct"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Job Knowlegde"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Work Quality"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ProgressBar
                            android:id="@+id/userReviewProg"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:max="5"
                            android:visibility="gone"
                            android:padding="@dimen/_5dp"
                            android:progress="2"
                            android:progressBackgroundTint="@color/greyforText"
                            android:progressTint="@color/Blue" />

                        <ProgressBar
                            android:id="@+id/team_Workprog"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:max="5"
                            android:padding="@dimen/_5dp"
                            android:progress="2"
                            android:progressBackgroundTint="@color/greyforText"
                            android:progressTint="@color/Blue" />

                        <ProgressBar
                            android:id="@+id/skillProg"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:max="5"
                            android:padding="@dimen/_5dp"
                            android:progress="2"
                            android:progressBackgroundTint="@color/greyforText"
                            android:progressTint="@color/Blue" />

                        <ProgressBar
                            android:id="@+id/assisantceProg"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:visibility="gone"
                            android:progress="2"
                            android:max="5"
                            android:progressBackgroundTint="@color/greyforText"
                            android:progressTint="@color/Blue" />

                        <ProgressBar
                            android:id="@+id/attendanceProg"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:max="5"
                            android:padding="@dimen/_5dp"
                            android:progress="2"
                            android:progressBackgroundTint="@color/greyforText"
                            android:progressTint="@color/Blue" />

                        <ProgressBar
                            android:id="@+id/WorkdeliveryProg"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:visibility="gone"
                            android:padding="@dimen/_5dp"
                            android:progress="2"
                            android:max="5"
                            android:progressBackgroundTint="@color/greyforText"
                            android:progressTint="@color/Blue" />

                        <ProgressBar
                            android:id="@+id/performanceProg"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:progress="2"
                            android:max="5"
                            android:visibility="gone"
                            android:progressBackgroundTint="@color/greyforText"
                            android:progressTint="@color/Blue" />

                        <ProgressBar
                            android:id="@+id/generalProg"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:progress="2"
                            android:max="5"
                            android:progressBackgroundTint="@color/greyforText"
                            android:progressTint="@color/Blue" />

                        <ProgressBar
                            android:id="@+id/jobKnowProg"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:progress="2"
                            android:max="5"
                            android:progressBackgroundTint="@color/greyforText"
                            android:progressTint="@color/Blue" />

                        <ProgressBar
                            android:id="@+id/workQualityProg"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:progress="2"
                            android:max="5"
                            android:progressBackgroundTint="@color/greyforText"
                            android:progressTint="@color/Blue" />


                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/editLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/grey_bg_rounded"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10"
                        android:gravity="center"
                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20dp"
                            android:layout_marginBottom="@dimen/_10"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="User Reviews"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Team work"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Skills"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Assistance"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Attendance"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Work Delivery"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Performance"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="General Conduct"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Job Knowlegde"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:gravity="center"
                            android:padding="@dimen/_5dp"
                            android:text="Work Quality"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_15" />


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                            android:id="@+id/userReview_inc_dec"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/blue_bg"
                            android:gravity="center"
                            android:maxLength="1"
                            android:paddingStart="15dp"
                            android:paddingEnd="10dp"
                            app:decrementText="-"
                            app:middleText="0" />

                        <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                            android:id="@+id/team_inc_dec"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/blue_bg"
                            android:gravity="center"
                            android:paddingStart="15dp"
                            android:paddingEnd="10dp"
                            app:middleText="0" />

                        <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                            android:id="@+id/skill_inc_dec"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/blue_bg"
                            android:gravity="center"
                            android:paddingStart="15dp"
                            android:paddingEnd="10dp"
                            app:middleText="0" />

                        <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                            android:id="@+id/assisantce_inc_dec"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/blue_bg"
                            android:gravity="center"
                            android:paddingStart="15dp"
                            android:paddingEnd="10dp"
                            app:middleText="0" />

                        <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                            android:id="@+id/attendance_inc_dec"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/blue_bg"
                            android:gravity="center"
                            android:paddingStart="15dp"
                            android:paddingEnd="10dp"
                            app:middleText="0" />

                        <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                            android:id="@+id/Workdelivery_inc_dec"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/blue_bg"
                            android:gravity="center"
                            android:paddingStart="15dp"
                            android:paddingEnd="10dp"
                            app:middleText="0" />

                        <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                            android:id="@+id/performance_inc_dec"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/blue_bg"
                            android:gravity="center"
                            android:paddingStart="15dp"
                            android:paddingEnd="10dp"
                            app:middleText="0" />

                        <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                            android:id="@+id/general_inc_dec"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/blue_bg"
                            android:gravity="center"
                            android:paddingStart="15dp"
                            android:paddingEnd="10dp"
                            app:decrementText="-"
                            app:middleText="0" />

                        <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                            android:id="@+id/jobKnowled_inc_dec"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/blue_bg"
                            android:gravity="center"
                            android:paddingStart="15dp"
                            android:paddingEnd="10dp"
                            app:middleText="0" />

                        <dev.dayaonweb.incrementdecrementbutton.IncrementDecrementButton
                            android:id="@+id/workQuality_inc_dec"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_margin="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/blue_bg"
                            android:gravity="center"
                            android:paddingStart="15dp"
                            android:paddingEnd="10dp"
                            app:middleText="0" />

                        <TextView
                            android:id="@+id/Update"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_10"
                            android:background="@drawable/blue_bg"
                            android:paddingStart="@dimen/_30dp"
                            android:paddingTop="@dimen/_10"
                            android:paddingEnd="@dimen/_30dp"
                            android:paddingBottom="@dimen/_10"
                            android:text="Update"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_18sp" />

                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/graphLaout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_10"
                android:background="@drawable/dark_grey_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_20dp"
                    android:layout_marginTop="@dimen/_10"
                    android:layout_weight="2"
                    android:padding="5dp"
                    android:text="Progress Chart"
                    android:textColor="@color/greyforText"
                    android:textSize="18dp" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_margin="@dimen/_10"
                    android:layout_marginTop="@dimen/_10"
                    android:padding="@dimen/_10" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</layout>
