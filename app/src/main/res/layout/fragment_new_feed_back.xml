<?xml version="1.0" encoding="utf-8"?>
<layout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="@dimen/_10dp"
        tools:context=".manager.activity.FeedBackFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="@dimen/_20dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:src="@drawable/backbutton"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Feedback"
                android:textColor="@color/greyforText"
                android:textSize="22sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_20dp"
            android:background="@drawable/feed_bck_grey"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_10">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10dp"
                android:layout_marginTop="@dimen/_20dp"
                android:text="Reason"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <Spinner
                android:id="@+id/feedbackType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/_10"
                android:background="@drawable/text_bg_darkgrey"
                android:padding="@dimen/_5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10dp"
                android:layout_marginTop="@dimen/_20dp"
                android:text="Description"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/feedback"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginStart="@dimen/_10"
                android:layout_marginTop="@dimen/_20dp"
                android:layout_marginEnd="@dimen/_10"
                android:background="@drawable/text_bg_darkgrey"
                android:hint="Discuss Your Views"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:gravity="top"
                android:padding="@dimen/_5dp"
                android:textColor="@color/greyforText"
                android:textColorHint="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:layout_weight="1"
                android:background="@drawable/attendancebutton"
                android:gravity="center"
                android:paddingStart="@dimen/_30dp"
                android:paddingTop="@dimen/_10"
                android:paddingEnd="@dimen/_30dp"
                android:paddingBottom="@dimen/_10"
                android:text="Submit"
                android:textColor="@color/white"
                android:textSize="16dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_marginTop="@dimen/_20dp"
            android:fontFamily="@font/dm_sans"
            android:text="Recent Feedback"
            android:textColor="#CCCCCC"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10" />
    </LinearLayout>
</layout>
