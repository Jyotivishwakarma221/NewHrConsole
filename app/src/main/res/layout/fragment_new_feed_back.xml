<?xml version="1.0" encoding="utf-8"?>
<layout>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="@dimen/_10dp"
        tools:context=".manager.activity.FeedBackFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="@dimen/_20dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:src="@drawable/backbutton"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Feedback"
                android:fontFamily="@font/dm_sans"
                android:textFontWeight="700"
                android:textColor="@color/greyforText"
                android:textSize="22sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_20dp"
            android:background="@drawable/feed_bck_grey"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_10">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10dp"
                android:layout_marginTop="@dimen/_20dp"
                android:text="Reason"
                android:fontFamily="@font/dm_sans"
                android:textFontWeight="500"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <Spinner
                android:id="@+id/feedbackType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10dp"
                android:fontFamily="@font/dm_sans"
                android:textFontWeight="400"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/_10"
                android:background="@drawable/text_bg_darkgrey"
                android:padding="@dimen/_5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10dp"
                android:layout_marginTop="@dimen/_20dp"
                android:text="Description"
                android:textColor="@color/white"
                android:fontFamily="@font/dm_sans"
                android:textFontWeight="500"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/feedback"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginStart="@dimen/_10"
                android:layout_marginTop="@dimen/_20dp"
                android:layout_marginEnd="@dimen/_10"
                android:fontFamily="@font/dm_sans"
                android:textFontWeight="400"
                android:background="@drawable/text_bg_darkgrey"
                android:hint="Discuss Your Views"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:gravity="top"
                android:padding="@dimen/_5dp"
                android:textColor="@color/greyforText"
                android:textColorHint="@color/white"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10"
                android:gravity="center"
                android:padding="@dimen/_10"
                android:layout_marginStart="@dimen/_10dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upload File"
                    android:textColor="@color/white"
                    android:fontFamily="@font/dm_sans"
                    android:textFontWeight="500"
                    android:textSize="18dp" />

                <ImageView
                    android:id="@+id/uploadDoc"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="end"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_weight="1"
                    android:background="@drawable/grey_bg_rounded"
                    android:padding="@dimen/_5dp"
                    android:src="@drawable/uploadwhite" />

                <LinearLayout
                    android:id="@+id/uploadDocname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/grey_bg_rounded"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5dp"
                        android:src="@drawable/uploadwhite"
                        android:text="File "
                        android:padding="@dimen/_10dp"
                        android:textColor="@color/white"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/deleteUploadedImg"
                        android:layout_width="45dp"
                        android:layout_height="50dp"
                        android:padding="@dimen/_10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/baseline_close_24" />
                </LinearLayout>

            </LinearLayout>


            <TextView
                android:id="@+id/submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:layout_weight="1"
                android:background="@drawable/attendancebutton"
                android:gravity="center"
                android:paddingStart="@dimen/_30dp"
                android:paddingTop="@dimen/_10"
                android:paddingEnd="@dimen/_30dp"
                android:paddingBottom="@dimen/_10"
                android:text="Submit"
                android:textColor="@color/white"
                android:textSize="16dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10dp"
            android:textFontWeight="500"
            android:layout_marginTop="@dimen/_20dp"
            android:fontFamily="@font/dm_sans"
            android:text="Recent Feedback"
            android:textColor="#CCCCCC"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10" />
    </LinearLayout>
</ScrollView>

</layout>
