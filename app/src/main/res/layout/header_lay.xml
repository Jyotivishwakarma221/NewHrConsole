<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="280dp"
    android:background="@color/Card">

    <!-- Profile Image -->
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/imageProfile"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="@dimen/_40dp"
        android:paddingTop="@dimen/_10dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:scaleType="centerCrop"
        app:riv_oval="true"/>

    <View
        android:id="@+id/green_Dot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignTop="@id/imageProfile"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="-25dp"
        android:layout_toStartOf="@id/imageProfile"
        android:background="@drawable/green_dot"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imageProfile"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins"
        android:textColor="@color/white"
        android:gravity="center"
        android:textSize="18sp"/>

    <!-- Designation TextView -->
    <TextView
        android:id="@+id/designationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/nameText"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:textSize="15sp"/>

    <!-- Linear Layout for Two Text Views -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_10dp"
        android:layout_marginStart="@dimen/_40dp"
        android:layout_below="@+id/designationText">

        <!-- First TextView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/last_login"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins"
            android:textSize="14sp"
            android:layout_marginStart="@dimen/_5dp"/>

        <!-- Second TextView -->
        <TextView
            android:id="@+id/lastLogins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/_5dp"
            android:layout_marginEnd="@dimen/_5dp"
            android:textColor="@color/white"
            android:textSize="14sp"/>

    </LinearLayout>
</RelativeLayout>
