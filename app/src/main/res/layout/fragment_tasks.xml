        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10"
            android:background="@drawable/dark_grey_bg"
            android:clickable="false">

            <TextView
                android:id="@+id/addnewTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5dp"
                android:layout_marginStart="@dimen/_10"
                android:layout_marginEnd="@dimen/_15"
                android:background="@drawable/blue_border"
                android:clickable="true"
                android:gravity="center"
                android:padding="@dimen/_10"
                android:text="+ Add Task"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="15dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/downloadIcon"
                    android:layout_width="@dimen/_60dp"
                    android:layout_height="50dp"
                    android:layout_gravity="end"
                    android:clickable="true"
                    android:padding="@dimen/_5dp"
                    android:src="@drawable/download" />

                <ImageView
                    android:id="@+id/filter"
                    android:layout_width="@dimen/_60dp"
                    android:layout_height="50dp"
                    android:clickable="true"
                    android:gravity="center"
                    android:padding="@dimen/_5dp"
                    android:src="@drawable/filter_img"
                    android:text="  Filter  "
                    android:textColor="@color/greyforText"
                    android:textSize="22sp" />

            </LinearLayout>
        </RelativeLayout>
        <!--        <androidx.viewpager.widget.ViewPager-->
        <!--            android:id="@+id/viewPager"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_margin="@dimen/_5dp">-->

        <!--        </androidx.viewpager.widget.ViewPager>-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_5dp"
            android:layout_marginTop="@dimen/_20dp"
            android:layout_weight="2"
            android:background="@drawable/dark_grey_bg"
            android:elevation="@dimen/_5dp"
            android:paddingLeft="@dimen/_5dp"
            android:paddingTop="@dimen/_20dp"
            android:paddingRight="@dimen/_5dp">

            <LinearLayout
                android:id="@id/topLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15"
                android:orientation="horizontal"
                android:weightSum="4">

                <LinearLayout
                    android:id="@+id/firstlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_marginStart="@dimen/_20dp"
                    android:layout_weight=".5"
                    android:background="@drawable/black_button"
                    android:padding="@dimen/_5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:text="ID :"
                        android:textColor="@color/greyforText" />

                    <TextView
                        android:id="@+id/id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/_10"
                        android:paddingEnd="@dimen/_10"
                        android:text="****"
                        android:textColor="@color/white" />

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="15dp"
                        android:layout_marginStart="@dimen/_5dp"
                        android:src="@drawable/green_dot" />
                </LinearLayout>


                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/white" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/lay2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/topLayout"
                android:layout_alignParentStart="true"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="@dimen/_5dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="  Name  "
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text=":"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text=" "
                    android:textColor="@color/greyforText"
                    android:textSize="14dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lay3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lay2"
                android:layout_margin="5dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Update Task"
                    android:textColor="@color/white" />


                <Spinner
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="@dimen/_5dp"
                    android:background="@drawable/custom_spinner_bg"
                    android:hint="Select From Below"
                    android:spinnerMode="dropdown"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textSize="15dp" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/lay4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lay3"
                android:layout_alignParentStart="true"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="@dimen/_5dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Deadline"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text=":"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/deadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text=" -- "
                    android:textColor="@color/greyforText"
                    android:textSize="14dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/taskk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lay4"
                android:layout_marginStart="@dimen/_5dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="@dimen/_5dp"
                android:gravity="center"
                android:text="Tasks"
                android:textColor="@color/white" />

            <!--            <androidx.recyclerview.widget.RecyclerView-->
            <!--                android:id="@+id/taskComments"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:layout_below="@+id/taskk"-->
            <!--                android:layout_marginLeft="@dimen/_5dp"-->
            <!--                android:layout_marginTop="@dimen/_10"-->
            <!--                android:layout_marginRight="@dimen/_5dp"-->
            <!--                android:layout_marginBottom="@dimen/_20dp" />-->
<ScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:layout_below="@+id/taskk"
    android:layout_marginLeft="@dimen/_5dp"
    android:layout_marginTop="@dimen/_10"
    android:layout_marginRight="@dimen/_5dp"
    android:layout_marginBottom="@dimen/_40dp">
    <TextView
        android:id="@+id/taskComments"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text=""
        android:paddingBottom="@dimen/_30dp"
        android:textColor="@color/white" />
</ScrollView>


<!--            <TextView-->
<!--                android:id="@+id/showImg"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:gravity="center"-->
<!--                android:layout_alignParentBottom="true"-->
<!--                android:text="Show Image"-->
<!--                android:paddingStart="@dimen/_30dp"-->
<!--                android:paddingEnd="@dimen/_30dp"-->
<!--                android:paddingTop="@dimen/_5dp"-->
<!--                android:paddingBottom="@dimen/_5dp"-->
<!--                android:layout_marginStart="@dimen/_60dp"-->
<!--                android:layout_marginEnd="@dimen/_60dp"-->
<!--                android:layout_marginBottom="@dimen/_5dp"-->
<!--                android:background="@drawable/blue_bg"-->
<!--                android:textColor="@color/white"-->
<!--                android:textSize="@dimen/_15"-->
<!--                android:textStyle="bold" />-->


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fileRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_below="@+id/scroll"
                android:foregroundGravity="center"
                android:padding="5dp" />


        </RelativeLayout>
        <LinearLayout
            android:id="@+id/Addcomments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="5dp"
            android:background="@drawable/dark_grey_bg"
            android:clickable="false"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="@dimen/_5dp"
            android:layout_below="@+id/fileRecycler"
            >

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/profilephoto"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:src="@drawable/profile"
                android:layout_margin="5dp"
                android:scaleType="centerCrop"
                app:riv_oval="true"
                android:textColor="@color/white" />

            <com.investmango.hrconsole.commonclasses.InitialAvatarView
                android:id="@+id/initialAvatar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:layout_margin="5dp"/>
            <EditText
                android:id="@+id/comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:background="@drawable/grey_bg_rounded"
                android:clickable="true"
                android:gravity="center"
                android:hint="Write a comment"
                android:padding="10dp"
                android:textColor="@color/greyforText"
                android:textColorHint="@color/white"
                android:textSize="14dp" />

            <ImageView
                android:id="@+id/sendComment"
                android:layout_width="50dp"
                android:layout_height="30dp"
                android:layout_margin="@dimen/_5dp"
                android:clickable="true"
                android:src="@drawable/baseline_arrow_circle_right_24" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/paging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="@dimen/_5dp"
            android:layout_weight="1"
            android:clickable="false"
            android:padding="@dimen/_10"
            android:weightSum="3">

            <ImageView
                android:id="@+id/previousPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:src="@drawable/right_arrow" />

            <TextView
                android:id="@+id/pagenumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:clickable="true"
                android:gravity="center"
                android:text="0/0"
                android:textColor="@color/white"
                android:textSize="@dimen/_18sp" />

            <ImageView
                android:id="@+id/nextPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:src="@drawable/left_arrow" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</layout>

