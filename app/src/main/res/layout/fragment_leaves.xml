<?xml version="1.0" encoding="utf-8"?>
<layout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:background="@android:color/black"
        android:orientation="vertical"
        android:padding="@dimen/_10dp"
        tools:context=".EmployeeAction.EmployeeActions">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="@dimen/_20dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:src="@drawable/backbutton"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Leave History"
                android:textColor="@color/greyforText"
                android:textSize="22sp" />

        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_5dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/tab_bg"
            android:elevation="@dimen/_30dp"
            android:paddingBottom="@dimen/_10dp"
            app:tabBackground="@drawable/tab_selected"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/tab_selected"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/white"
            app:tabTextColor="#A2A2B5" />

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/NewLeave"
            style="@style/AttendanceButton"
            android:layout_width="@dimen/_150dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="-50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/attendancebutton"
            android:fontFamily="@font/dm_sans"
            android:hint="+ New Leave"
            android:textColorHint="@color/white" />

    </LinearLayout>
</layout>
