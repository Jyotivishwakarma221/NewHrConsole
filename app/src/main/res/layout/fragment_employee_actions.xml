<?xml version="1.0" encoding="utf-8"?>
<layout>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/containerrr"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:orientation="vertical"
            tools:context=".EmployeeAction.EmployeeActions">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20dp"
                android:orientation="vertical"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/MemberStatus"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginBottom="10dp"
                        app:cardBackgroundColor="#6D9BFF"
                        app:cardCornerRadius="18dp">

                        <!-- Adding TextView for "My Performance" -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_20sp"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Team Management"
                            android:textColor="@android:color/white"
                            android:textFontWeight="500"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ManageBtn"
                            style="@style/CustomButton"
                            android:layout_width="120dp"
                            android:layout_height="40dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="86dp"
                            android:layout_marginEnd="20dp"
                            android:elevation="@dimen/_20dp"
                            android:fontFamily="@font/dm_sans"
                            android:hint="Check Now"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp"
                            android:textColorHint="@color/white"
                            android:textSize="14sp" />
                    </androidx.cardview.widget.CardView>


                    <androidx.cardview.widget.CardView
                        android:id="@+id/TeamTask"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginBottom="10dp"
                        app:cardBackgroundColor="#222222"
                        app:cardCornerRadius="18dp">

                        <!-- Adding TextView for "My Performance" -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_20sp"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Team Task"
                            android:textColor="@android:color/white"
                            android:textFontWeight="500"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/taskBtn"
                            android:layout_width="120dp"
                            android:layout_height="40dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="86dp"
                            android:layout_marginEnd="20dp"
                            android:elevation="@dimen/_20dp"
                            android:fontFamily="@font/dm_sans"
                            android:hint="Check Now"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp"
                            android:textColorHint="@color/white"
                            android:textSize="14sp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/assignments"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginBottom="10dp"
                        app:cardBackgroundColor="#CE3262"
                        app:cardCornerRadius="18dp">

                        <!-- Adding TextView for "My Performance" -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_20sp"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Projects"
                            android:textColor="@android:color/white"
                            android:textFontWeight="500"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ProjectBtn"
                            android:layout_width="120dp"
                            android:layout_height="40dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="86dp"
                            android:layout_marginEnd="20dp"
                            android:elevation="@dimen/_20dp"
                            android:fontFamily="@font/dm_sans"
                            android:hint="Check Now"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp"
                            android:textColorHint="@color/white"
                            android:textSize="14sp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/AddMeeting"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginBottom="10dp"
                        app:cardBackgroundColor="#222222"
                        app:cardCornerRadius="18dp">

                        <!-- Adding TextView for "My Performance" -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_20sp"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="My Meetings"
                            android:textColor="@android:color/white"
                            android:textFontWeight="500"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/MeetingBtn"
                            android:layout_width="120dp"
                            android:layout_height="40dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="86dp"
                            android:layout_marginEnd="20dp"
                            android:elevation="@dimen/_20dp"
                            android:fontFamily="@font/dm_sans"
                            android:hint="Check Now"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp"
                            android:textColorHint="@color/white"
                            android:textSize="14sp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/StaffLeaves"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginBottom="10dp"
                        app:cardBackgroundColor="#5C7378"
                        app:cardCornerRadius="18dp">

                        <!-- Adding TextView for "My Performance" -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_20sp"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Leave Requests"
                            android:textColor="@android:color/white"
                            android:textFontWeight="500"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/LeaveBtn"
                            android:layout_width="120dp"
                            android:layout_height="40dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="86dp"
                            android:layout_marginEnd="20dp"
                            android:elevation="@dimen/_20dp"
                            android:fontFamily="@font/dm_sans"
                            android:src="@drawable/mdtp_ic_chevron_right_black_24dp"
                            android:textColorHint="@color/white"
                            android:textSize="14sp" />
                    </androidx.cardview.widget.CardView>


                </LinearLayout>


            </LinearLayout>


        </LinearLayout>
    </ScrollView>
</layout>