<?xml version="1.0" encoding="utf-8"?>
<layout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:orientation="vertical"
        android:padding="@dimen/_10">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="top"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:text="Enter OTP"
                android:textColor="@color/white"
                android:textSize="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="@dimen/_30dp"
                android:gravity="center"
                android:text="Enter your OTP sent on your \n
registered email "
                android:textColor="#999999"
                android:textSize="17dp" />



            <EditText
                android:id="@+id/otp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50dp"
                android:layout_margin="@dimen/_10"
                android:layout_marginTop="@dimen/_40dp"
                android:background="@drawable/grey_bg_rounded"
                android:drawableStart="@drawable/lock_grey"
                android:drawablePadding="@dimen/_8dp"
                android:inputType="text"
                android:maxLines="1"
                android:padding="@dimen/_8dp"
                android:textColor="#999999"
                android:textColorHint="#999999"
                android:textSize="@dimen/_15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_20dp">


                <TextView
                    android:id="@+id/Verify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/blue_bg"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="center"
                    android:hint="Verify"
                    android:paddingTop="@dimen/_15"
                    android:paddingBottom="@dimen/_15"
                    android:textColorHint="@color/white"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</layout>
