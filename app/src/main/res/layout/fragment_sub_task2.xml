<?xml version="1.0" encoding="utf-8"?>
<layout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/_10"
    tools:context=".manager.activity.SubTaskFragment">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=" Project Tasks "
        android:textColor="@color/greyforText"
        android:layout_margin="@dimen/_10"
        android:textSize="22sp" />
    <TextView
        android:id="@+id/addNew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="@dimen/_20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/blue_border"
        android:drawableStart="@drawable/baseline_add_24"
        android:gravity="start"
        android:paddingStart="@dimen/_10"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/_10"
        android:paddingBottom="5dp"
        android:text=" Add New"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/subtaskRecycler"
        android:layout_width="match_parent"
        android:layout_margin="@dimen/_10"
        android:layout_height="wrap_content" />
    <TextView
        android:id="@+id/noDataFound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No Data Found"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"/>

</LinearLayout>
</layout>
