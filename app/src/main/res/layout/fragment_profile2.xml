<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".profile.ProfileFragment">


            <FrameLayout
                android:id="@+id/full_Layouttt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/black"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/firstLay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/profilebg"
                        android:gravity="center"
                        android:orientation="vertical">


                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/profilePhoto"
                            android:layout_width="@dimen/_100dp"
                            android:layout_height="@dimen/_100dp"
                            android:scaleType="centerCrop"
                            app:riv_oval="true"
                            android:padding="@dimen/_5dp"
                            android:background="@drawable/grey_bg_rounded"
                            android:layout_gravity="center" />
                        <com.investmango.hrconsole.commonclasses.InitialAvatarView
                            android:id="@+id/initialAvatar"
                            android:layout_width="@dimen/_100dp"
                            android:layout_height="@dimen/_100dp"
                            android:padding="@dimen/_5dp"
                            android:visibility="gone"
                            android:layout_gravity="center"/>

                        <TextView
                            android:id="@+id/name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/profilePhoto"
                            android:fontFamily="@font/dm_sans"
                            android:text="   "
                            android:textColor="@color/white"
                            android:textSize="14dp" />

                        <TextView
                            android:id="@+id/designation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/profilePhoto"
                            android:fontFamily="@font/dm_sans"
                            android:text=""
                            android:textColor="#989898"
                            android:textSize="14dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/black_button"
                            android:orientation="horizontal"
                            android:padding="@dimen/_5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Last Login :"
                                android:textColor="@color/greyforText"
                                android:textSize="12dp" />

                            <TextView
                                android:id="@+id/lastlogin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="  "
                                android:textColor="@color/white"
                                android:textSize="12dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/personalinfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10"
                        android:layout_marginTop="@dimen/_5dp"
                        android:fontFamily="@font/dm_sans"
                        android:text="Personal Information"
                        android:textColor="@color/white"
                        android:textSize="22dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10"
                        android:orientation="vertical"
                        android:padding="@dimen/_5dp">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10"
                            android:layout_marginTop="@dimen/_5dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="UID"
                            android:textColor="#989898"
                            android:textSize="@dimen/_18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/grey_bg_rounded">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_10dp"
                                android:src="@drawable/user2" />

                            <TextView
                                android:id="@+id/userId"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/dm_sans"
                                android:gravity="start"
                                android:padding="@dimen/_15"
                                android:text="      "
                                android:textColor="#989898"
                                android:textSize="14dp" />

                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10"
                            android:layout_marginTop="@dimen/_5dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Tenure"
                            android:textColor="#989898"
                            android:textSize="@dimen/_18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/grey_bg_rounded">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_10dp"
                                android:src="@drawable/calender2" />

                            <TextView
                                android:id="@+id/tenure"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/dm_sans"
                                android:gravity="start"
                                android:padding="@dimen/_15"
                                android:text="      "
                                android:textColor="#989898"
                                android:textSize="14dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10"
                            android:layout_marginTop="@dimen/_5dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Phone No."
                            android:textColor="#989898"
                            android:textSize="@dimen/_18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/grey_bg_rounded">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_10dp"
                                android:src="@drawable/call" />

                            <TextView
                                android:id="@+id/phoneNum"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/dm_sans"
                                android:gravity="start"
                                android:padding="@dimen/_15"
                                android:text="  "
                                android:textColor="#989898"
                                android:textSize="14dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/_20dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_10"
                                    android:layout_marginTop="@dimen/_5dp"
                                    android:fontFamily="@font/dm_sans"
                                    android:text="D.O.B"
                                    android:textColor="#989898"
                                    android:textSize="@dimen/_18sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="5dp"
                                    android:background="@drawable/grey_bg_rounded">

                                    <ImageView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginStart="@dimen/_10dp"
                                        android:src="@drawable/calender2" />

                                    <TextView
                                        android:id="@+id/Dob"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/dm_sans"
                                        android:gravity="start"
                                        android:padding="@dimen/_15"
                                        android:text="Date"
                                        android:textColor="#989898"
                                        android:textSize="14dp" />

                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_20dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_10"
                                    android:layout_marginTop="@dimen/_5dp"
                                    android:fontFamily="@font/dm_sans"
                                    android:text="Gender"
                                    android:textColor="#989898"
                                    android:textSize="@dimen/_18sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="5dp"
                                    android:background="@drawable/grey_bg_rounded">

                                    <ImageView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginStart="@dimen/_10dp"
                                        android:src="@drawable/user2" />

                                    <TextView
                                        android:id="@+id/gender"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/dm_sans"
                                        android:gravity="start"
                                        android:padding="@dimen/_15"
                                        android:text="Male"
                                        android:textColor="#989898"
                                        android:textSize="14dp" />

                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10"
                            android:layout_marginTop="@dimen/_5dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Your Email"
                            android:textColor="#989898"
                            android:textSize="@dimen/_18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/grey_bg_rounded">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_10dp"
                                android:src="@drawable/mail2" />

                            <TextView
                                android:id="@+id/email"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/dm_sans"
                                android:gravity="start"
                                android:padding="@dimen/_15"
                                android:text="  "
                                android:textColor="#989898"
                                android:textSize="14dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10"
                            android:layout_marginTop="@dimen/_5dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Address"
                            android:textColor="#989898"
                            android:textSize="@dimen/_18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/grey_bg_rounded">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_10dp"
                                android:src="@drawable/location" />

                            <TextView
                                android:id="@+id/location"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/dm_sans"
                                android:gravity="start"
                                android:padding="@dimen/_15"
                                android:text="     "
                                android:textColor="#989898"
                                android:textSize="14dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10"
                        android:layout_marginTop="@dimen/_5dp"
                        android:fontFamily="@font/dm_sans"
                        android:text="Company Information"
                        android:textColor="@color/white"
                        android:textSize="22dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10"
                        android:orientation="vertical"
                        android:padding="@dimen/_5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10"
                            android:layout_marginTop="@dimen/_10dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Joining Date"
                            android:textColor="#989898"
                            android:textSize="@dimen/_18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/grey_bg_rounded">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_10dp"
                                android:src="@drawable/calender2" />

                            <TextView
                                android:id="@+id/joiningDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/dm_sans"
                                android:gravity="start"
                                android:padding="@dimen/_15"
                                android:text="   "
                                android:textColor="#989898"
                                android:textSize="14dp" />

                        </LinearLayout>


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10"
                            android:layout_marginTop="@dimen/_5dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Department"
                            android:textColor="#989898"
                            android:textSize="@dimen/_18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/grey_bg_rounded">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_10dp"
                                android:src="@drawable/department" />

                            <TextView
                                android:id="@+id/Department"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/dm_sans"
                                android:gravity="start"
                                android:padding="@dimen/_15"
                                android:text="   "
                                android:textColor="#989898"
                                android:textSize="14dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10"
                            android:layout_marginTop="@dimen/_10dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Designation"
                            android:textColor="#989898"
                            android:textSize="@dimen/_18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/grey_bg_rounded">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_10dp"
                                android:src="@drawable/desig" />

                            <TextView
                                android:id="@+id/Designation2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/dm_sans"
                                android:gravity="start"
                                android:padding="@dimen/_15"
                                android:text=" "
                                android:textColor="#989898"
                                android:textSize="14dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10"
                            android:layout_marginTop="@dimen/_10dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="Reporting Manager"
                            android:textColor="#989898"
                            android:textSize="@dimen/_18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:background="@drawable/grey_bg_rounded">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_10dp"
                                android:src="@drawable/user2" />

                            <TextView
                                android:id="@+id/ReportingManager"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/dm_sans"
                                android:gravity="start"
                                android:padding="@dimen/_15"
                                android:text="------- "
                                android:textColor="#989898"
                                android:textSize="14dp" />

                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/userDocument"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20dp"
                        android:layout_marginTop="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_20dp"
                        android:background="@drawable/light_grey_bg"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:paddingTop="@dimen/_20dp"
                        android:paddingBottom="@dimen/_20dp"
                        android:text="User Documentation"
                        android:textColor="#6499E8"
                        android:textSize="@dimen/_18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/changePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20dp"
                        android:layout_marginTop="@dimen/_15"
                        android:layout_marginEnd="@dimen/_20dp"
                        android:background="@drawable/light_grey_bg"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:paddingTop="@dimen/_20dp"
                        android:paddingBottom="@dimen/_20dp"
                        android:text="Change Password"
                        android:textColor="#6499E8"
                        android:textSize="@dimen/_18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/saveChanges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20dp"
                        android:layout_marginTop="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_20dp"
                        android:background="@drawable/blue_bg"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:paddingTop="@dimen/_20dp"
                        android:paddingBottom="@dimen/_20dp"
                        android:text="Save Changes"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/signOut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_20dp"
                        android:layout_marginTop="@dimen/_10dp"
                        android:layout_marginEnd="@dimen/_20dp"
                        android:background="@drawable/signout_btn"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/_10"
                        android:paddingTop="@dimen/_20dp"
                        android:paddingBottom="@dimen/_20dp"
                        android:text="Sign out"
                        android:textColor="#FF2828"
                        android:textSize="@dimen/_18sp"
                        android:textStyle="bold" />


                </LinearLayout>
            </FrameLayout>
        </ScrollView>
    </layout>
