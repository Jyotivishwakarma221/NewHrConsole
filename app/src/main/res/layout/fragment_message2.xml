<?xml version="1.0" encoding="utf-8"?>
<layout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clickable="true"
    android:orientation="vertical"
    android:padding="@dimen/_10dp"
    tools:context=".manager.activity.MessageFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/backbutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:visibility="gone"
            android:src="@drawable/backbutton" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Messages "
            android:textColor="@color/greyforText"
            android:textSize="22sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/selectMonth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16dp"
        android:padding="@dimen/_10dp"
        android:layout_gravity="start"
        android:layout_margin="@dimen/_5dp"
        android:textColor="@color/white"
        android:drawableEnd="@drawable/baseline_arrow_drop_down_24"
        android:text="month"/>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cardview_border"
    android:gravity="start"
    android:paddingTop="@dimen/_10"
    android:weightSum="2"
    android:paddingBottom="@dimen/_10"
    android:layout_margin="5dp"
    android:paddingStart="@dimen/_10"
    android:orientation="horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="    Messages History "
        android:layout_weight="1"
        android:textColor="#CCCCCC"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/addNew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text=" Add New"
        android:paddingStart="@dimen/_10"
        android:paddingEnd="@dimen/_10"
        android:paddingBottom="5dp"
        android:paddingTop="10dp"
        android:drawableStart="@drawable/baseline_add_24"
        android:background="@drawable/blue_border"
        android:layout_marginStart="@dimen/_20dp"
        android:textColor="@color/white"
        android:textSize="14sp" />


</LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/meassages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_5dp"
        android:layout_margin="@dimen/_10"
        />
</LinearLayout>

</layout>
