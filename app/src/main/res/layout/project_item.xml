<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_margin="@dimen/_5dp"
        app:cardCornerRadius="@dimen/_15"
        app:cardBackgroundColor="#111111"
        android:elevation="@dimen/_5dp">

        <RelativeLayout
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/project_bg"
            android:padding="16dp">


            <TextView
                android:id="@+id/priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10"
                android:layout_marginTop="@dimen/_20dp"
                android:background="@drawable/dark_grey_bg"
                android:drawableStart="@drawable/red_dot"
                android:padding="@dimen/_10"
                android:text="     "
                android:textColor="@color/greyforText"
                android:textSize="@dimen/_10" />

            <TextView
                android:id="@+id/projectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/priority"
                android:layout_marginStart="@dimen/_10"
                android:layout_marginTop="@dimen/_10"
                android:gravity="start"
                android:text="    "
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/prog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/projectName"
                android:layout_marginStart="@dimen/_10"
                android:layout_marginTop="@dimen/_10"
                android:gravity="start"
                android:text="  Progress :"
                android:textColor="@color/white"
                android:textSize="10sp" />


            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/prog"
                android:layout_marginStart="@dimen/_5dp"
                android:layout_marginTop="@dimen/_10dp"
                android:layout_marginEnd="@dimen/_5dp" />

            <TextView
                android:id="@+id/projctMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/progressbar"
                android:layout_marginStart="@dimen/_10"
                android:layout_marginTop="@dimen/_10"
                android:gravity="start"
                android:text="  Project member "
                android:textColor="@color/white"
                android:textSize="10sp" />



            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/photo1"
                android:layout_width="@dimen/_30dp"
                android:layout_height="30dp"
                app:riv_oval="true"
                android:layout_below="@+id/projctMember"
                android:layout_marginStart="@dimen/_10"
                android:layout_marginTop="@dimen/_10"
                android:src="@drawable/profilephoto" />


            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/photo2"
                android:layout_width="@dimen/_30dp"
                android:layout_height="30dp"
                android:layout_below="@+id/projctMember"
                android:layout_marginTop="@dimen/_10"
                app:riv_oval="true"
                android:layout_toEndOf="@+id/photo1"
                android:src="@drawable/profilephoto" />


            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/photo3"
                android:layout_width="@dimen/_30dp"
                android:layout_height="30dp"
                android:layout_below="@+id/projctMember"
                android:layout_marginTop="@dimen/_10"
                app:riv_oval="true"
                android:layout_toEndOf="@+id/photo2"
                android:src="@drawable/profilephoto" />

            <TextView
                android:id="@+id/dead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/progressbar"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/_10"
                android:layout_marginTop="@dimen/_10"
                android:layout_marginEnd="@dimen/_40dp"
                android:gravity="start"
                android:text="  Dead Line "
                android:textColor="@color/white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/deadlineDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dead"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/_10"
                android:layout_marginTop="@dimen/_10"
                android:layout_marginEnd="@dimen/_30dp"

                android:background="@drawable/light_grey_bg"
                android:gravity="start"
                android:paddingStart="@dimen/_20dp"
                android:paddingTop="@dimen/_5dp"
                android:paddingEnd="@dimen/_20dp"
                android:paddingBottom="@dimen/_5dp"
                android:text="  12 May 2024 "
                android:textColor="@color/white"
                android:textSize="10sp" />


        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</layout>
