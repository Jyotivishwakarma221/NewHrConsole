<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomProgressDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:progressBarStyle">@style/CustomProgressBar</item>
    </style>

    <style name="CustomProgressBar" parent="@android:style/Widget.ProgressBar.Large">
        <item name="android:indeterminateDrawable">@drawable/custom_progress</item>

    </style>

    <style name="DarkBlueMenuItemStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:textColor">#000080</item>
    </style>

    <style name="AppTheme.DarkBluePopupMenu" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:popupMenuStyle">@style/DarkBlueMenuItemStyle</item>
    </style>

    <style name="SpinnerStyle">
        <item name="android:backgroundTint">#ce3262</item>
        <!-- Add more attributes here if needed -->
    </style>
    <style name="BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/bottomSheetStyleWrapper</item>
    </style>

    <style name="bottomSheetStyleWrapper" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="NavigationViewTextStyle">
        <item name="android:textColor">@color/DarkBlue</item>
    </style>

    <style name="SmallRatingBar">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">@dimen/_20dp</item>
    </style>

    <style name="CustomRatingBarStyle">
        <item name="android:progressTint">#f7af05</item>
    </style>

    <style name="CustomThemeOverlay_MaterialCalendar_Fullscreen"
        parent="@style/ThemeOverlay.MaterialComponents.MaterialCalendar.Fullscreen">
        <item name="materialCalendarStyle">@style/Custom_MaterialCalendar.Fullscreen</item>
    </style>

    <style name="Custom_MaterialCalendar.Fullscreen"
        parent="@style/Widget.MaterialComponents.MaterialCalendar.Fullscreen">
        <item name="android:windowFullscreen">false</item>
        <item name="android:layout_height">@dimen/_100dp</item>
    </style>
</resources>