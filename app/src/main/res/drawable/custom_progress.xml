<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <rotate
            android:fromDegrees="0"
            android:toDegrees="2500"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="ring">
                <size android:width="@dimen/_30dp" android:height="@dimen/_20dp" />
                <stroke android:width="4dp" android:color="@color/Button" />
            </shape>
        </rotate>
    </item>
</layer-list>
