<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background Rectangle (Black Fill) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" /> <!-- Black fill color -->
        </shape>
    </item>

    <!-- Border Rectangle (White Border) -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" /> <!-- Transparent fill color -->
            <stroke
                android:width="2dp"
            android:color="#FFFFFF" /> <!-- White border color -->
        </shape>
    </item>

</layer-list>
